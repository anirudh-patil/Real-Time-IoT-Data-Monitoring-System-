# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_ORIGIN=http://localhost:3000

# ==========================================
# AWS (EXISTING INFRASTRUCTURE - DO NOT RECREATE)
# ==========================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Existing DynamoDB tables (must already exist)
DYNAMODB_TELEMETRY_TABLE=EnergyTelemetry
DYNAMODB_USERS_TABLE=Users
DYNAMODB_DEVICES_TABLE=Devices
DYNAMODB_ALERTS_TABLE=Alerts
DYNAMODB_REFRESH_TOKENS_TABLE=RefreshTokens
DYNAMODB_ACTIVITY_LOGS_TABLE=ActivityLogs

# S3 bucket for user profile images (must already exist)
AWS_S3_PROFILE_IMAGES_BUCKET=

# Seconds since last heartbeat before a device is considered offline
DEVICE_OFFLINE_THRESHOLD_SECONDS=300

# ==========================================
# ALERT ENGINE THRESHOLDS
# ==========================================
ALERT_VOLTAGE_MIN=200
ALERT_VOLTAGE_MAX=250
ALERT_CURRENT_MAX=10
ALERT_TEMPERATURE_MAX=60
# Longer than DEVICE_OFFLINE_THRESHOLD_SECONDS - an escalation if a device
# stays unreachable well past the initial "offline" alert
ALERT_COMMUNICATION_TIMEOUT_SECONDS=900
# How often the background job checks for offline/timed-out devices
ALERT_OFFLINE_CHECK_INTERVAL_SECONDS=60

# ==========================================
# NOTIFICATIONS
# ==========================================
# Comma-separated list of active channels. Only 'email' is implemented;
# 'sms' and 'push' are architecture-ready stubs (see src/notifications/channels/)
NOTIFICATION_CHANNELS=email

# Existing AWS IoT Core endpoint (for MQTT subscriber)
AWS_IOT_ENDPOINT=
AWS_IOT_MQTT_TOPIC=devices/+/telemetry

# X.509 cert/key/CA file paths for AWS IoT Core mutual TLS.
# Optional: leave blank to run without the MQTT subscriber (device
# heartbeats then rely on the manual /devices/:id/heartbeat endpoint
# and future integrations instead of real-time push).
AWS_IOT_CERT_PATH=
AWS_IOT_KEY_PATH=
AWS_IOT_CA_PATH=

# ==========================================
# JWT / AUTH
# ==========================================
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# ==========================================
# EMAIL (NOTIFICATIONS)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=IoT Energy Monitoring Platform
SMTP_FROM_EMAIL=

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_DIR=src/logs
